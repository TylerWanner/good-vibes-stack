# =============================================================================
# Good Vibes Stack — Environment Configuration
# =============================================================================
# Copy to .env and fill in required values before running ./init.sh
# Required fields are marked with (required)

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=second_brain
POSTGRES_USER=second_brain
POSTGRES_PASSWORD=change-me-to-something-strong

# -----------------------------------------------------------------------------
# Telegram (for flow notifications and OpenClaw agent)
# -----------------------------------------------------------------------------
# Bot token from @BotFather — used by both flows and the agent
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID is your Telegram user ID (for DMs) or a group chat ID
# Find your user ID by messaging @userinfobot on Telegram
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# safe-docker (required)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SAFE_DOCKER_API_KEY=

# -----------------------------------------------------------------------------
# LLM Provider (for second-brain flows)
# -----------------------------------------------------------------------------
# Supported providers: ollama, anthropic
#
# Recommended models:
#   ollama:    qwen2.5:7b (fast, good quality) or qwen2.5:14b (better, slower)
#   anthropic: claude-sonnet-4-6 (best quality, requires API key)
#
SECOND_BRAIN_LLM_PROVIDER=ollama
SECOND_BRAIN_LLM_MODEL=qwen2.5:7b

# Ollama URLs (only needed if using ollama provider)
# SECOND_BRAIN_OLLAMA_BASE_URL=http://127.0.0.1:11434
# SECOND_BRAIN_OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434

# Anthropic (required if using anthropic provider)
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# OpenClaw Agent (optional — only if using --profile agent)
# -----------------------------------------------------------------------------
# Gateway token — used for authenticating to the gateway's REST API
# Only needed if using browser extension or external API calls to the agent
# Generate with: openssl rand -base64 32
# OPENCLAW_GATEWAY_TOKEN=

# Model for agent (default: claude-sonnet-4-6)
OPENCLAW_MODEL=anthropic/claude-sonnet-4-6
OPENCLAW_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Override agent state directory (default: ./state/agent)
# AGENT_STATE_DIR=~/agent-state

# -----------------------------------------------------------------------------
# Integrations (optional)
# -----------------------------------------------------------------------------
# Brave Search API
BRAVE_API_KEY=

# Readwise
READWISE_API_TOKEN=
READWISE_BASE_URL=https://readwise.io/api/v3

# Twitter / X (for post_tweet flow)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# Postgres Backups (optional — any S3-compatible storage)
# -----------------------------------------------------------------------------
# Works with: AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.
# BACKUP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_BUCKET=backups
# BACKUP_S3_PREFIX=postgres/
# BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# API Security (optional — disabled by default for local dev)
# -----------------------------------------------------------------------------
# API_SECRET_KEY=<generate with: openssl rand -hex 32>
# API_RATE_LIMIT=60/minute

# -----------------------------------------------------------------------------
# Advanced / Overrides
# -----------------------------------------------------------------------------
# Scrapling fetcher URL (default: http://scrapling-fetcher:8002)
# SCRAPLING_FETCHER_URL=http://scrapling-fetcher:8002

# Weekly digest settings
WEEKLY_DIGEST_ARTICLE_LIMIT=100

# Domain allowlist for auto-followed links (comma-separated)
# If empty, link expansion is disabled
INGEST_DOMAIN_ALLOWLIST=

# OpenTelemetry (default: local Tempo)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Stage 1: install dependencies
FROM python:3.12.9-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
# Stub packages so pip can resolve the editable install deps without full source
RUN mkdir -p data integrations nervous_system orchestration second_brain shared \
    && touch data/__init__.py integrations/__init__.py nervous_system/__init__.py \
          orchestration/__init__.py second_brain/__init__.py shared/__init__.py

RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: runtime
FROM python:3.12.9-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /usr/share/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        postgresql-client-16 \
        procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code — only what the worker needs
COPY pyproject.toml ./
COPY data/ ./data/
COPY integrations/ ./integrations/
COPY orchestration/ ./orchestration/
COPY second_brain/ ./second_brain/
COPY shared/ ./shared/
COPY alembic.ini ./
COPY sitecustomize.py ./

# Worker scripts only (not all of scripts/)
COPY scripts/worker.py scripts/startup_cleanup.py ./scripts/
# sync_blocks.py needed for init.sh bootstrap (runs inside worker via docker exec)
COPY scripts/sync_blocks.py ./scripts/

# Install package metadata only (deps already installed)
RUN pip install --no-cache-dir --no-deps .

# Startup: cleanup orphaned runs, then start worker with graceful drain
CMD ["bash", "-c", "python /app/scripts/startup_cleanup.py && python /app/scripts/worker.py"]

# Stage 1: install dependencies
FROM python:3.12.9-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
# Stub packages so pip can resolve the editable install deps without full source
RUN mkdir -p data integrations nervous_system orchestration second_brain shared \
    && touch data/__init__.py integrations/__init__.py nervous_system/__init__.py \
          orchestration/__init__.py second_brain/__init__.py shared/__init__.py

RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: runtime
FROM python:3.12.9-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        postgresql-client \
        procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY pyproject.toml ./
COPY config/ ./config/
COPY data/ ./data/
COPY integrations/ ./integrations/
COPY nervous_system/__init__.py ./nervous_system/
COPY orchestration/ ./orchestration/
COPY second_brain/ ./second_brain/
COPY shared/ ./shared/
COPY scripts/ ./scripts/
COPY alembic.ini ./

# Install package metadata only (deps already installed)
RUN pip install --no-cache-dir --no-deps .

CMD ["prefect", "worker", "start", "--pool", "default-pool"]

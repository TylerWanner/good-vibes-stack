# .env.blocks — one-time secret bootstrap for Prefect blocks
#
# Usage:
#   cp .env.blocks.example .env.blocks
#   # Fill in values
#   python3 scripts/sync_blocks.py --env-file .env.blocks   # or run via init.sh
#   rm .env.blocks                     # optional: delete after blocks are created (keep as backup if preferred)
#
# This file is gitignored. .env.blocks.example is the reference.
# To update a block value: recreate .env.blocks with the new value and re-run.
# Blocks are upserted (safe to run multiple times).

# ---------------------------------------------------------------------------
# Anthropic
# Shared credential: workflow secret and possibly agent/tool credential.
# Prefer a dedicated workflow-scoped key here for Prefect flows.
# Block name: anthropic-credentials
# ---------------------------------------------------------------------------
WORKFLOW_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Readwise
# Required for: sync_readwise flow
# Block name: readwise-credentials
# ---------------------------------------------------------------------------
READWISE_API_TOKEN=

# ---------------------------------------------------------------------------
# Brave Search
# Shared credential: used by flows and may also be used by agents/tools.
# Keep the workflow copy here; if agents also need Brave, wire that separately in local env.
# Block name: brave-credentials
# ---------------------------------------------------------------------------
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# S3-compatible Object Storage
# Required for: backup_postgres flow
# Block name: r2-credentials
# Secret material lives here; bucket/prefix/retention stay in .env.
# ---------------------------------------------------------------------------
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# .env.blocks — one-time secret bootstrap for Prefect blocks
#
# Usage:
#   cp .env.blocks.example .env.blocks
#   # Fill in values
#   bash scripts/bootstrap_blocks.sh   # or run via init.sh Phase 3c
#   rm .env.blocks                     # optional: delete after blocks are created (keep as backup if preferred)
#
# This file is gitignored. .env.blocks.example is the reference.
# To update a block value: recreate .env.blocks with the new value and re-run.
# Blocks are upserted (safe to run multiple times).

# ---------------------------------------------------------------------------
# Twitter / X
# Required for: post_tweet flow
# Block name: twitter-credentials
# ---------------------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ---------------------------------------------------------------------------
# Readwise
# Required for: sync_readwise flow
# Block name: readwise-credentials
# ---------------------------------------------------------------------------
READWISE_API_TOKEN=

# ---------------------------------------------------------------------------
# Brave Search
# Required for: web search in flows
# Block name: brave-credentials
# ---------------------------------------------------------------------------
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# R2 / Cloudflare Object Storage
# Required for: backup_postgres flow
# Block name: r2-credentials
# Note: already created by initialize flow if R2_* vars are in .env
# Override here to rotate credentials without touching .env
# ---------------------------------------------------------------------------
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

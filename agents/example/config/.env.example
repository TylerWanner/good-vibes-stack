# Agent-specific environment
# Copy to .env before starting the agent

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Agent-local Brave Search key (optional)
# Only needed if this agent uses Brave directly as a tool credential.
BRAVE_API_KEY=

# Optional agent-local Anthropic key.
# If set here, it overrides ANTHROPIC_API_KEY from the root .env for this agent only.
ANTHROPIC_API_KEY=

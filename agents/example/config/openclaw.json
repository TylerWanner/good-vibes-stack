{
  "models": {
    "providers": {
      "anthropic": {
        "api": "anthropic-messages",
        "baseUrl": "https://api.anthropic.com",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "input": ["text", "image"],
            "cost": { "input": 3, "output": 15 },
            "contextWindow": 200000,
            "maxTokens": 16000
          }
        ]
      },
      "openai-codex": {
        "api": "openai-codex-responses",
        "baseUrl": "https://api.openai.com/v1",
        "models": [
          {
            "id": "gpt-5.4",
            "name": "GPT-5.4",
            "input": ["text", "image"],
            "cost": { "input": 0, "output": 0 },
            "contextWindow": 400000,
            "maxTokens": 128000
          }
        ]
      },
      "ollama": {
        "api": "ollama",
        "baseUrl": "${OLLAMA_BASE_URL}",
        "models": [
          {
            "id": "qwen2.5:7b",
            "name": "Qwen 2.5 7B",
            "input": ["text"],
            "cost": { "input": 0, "output": 0 },
            "contextWindow": 32768,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${OPENCLAW_MODEL}"
      },
      "workspace": "/workspace"
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": ["*"],
      "streaming": "block"
    }
  },
  "plugins": {
    "allow": ["second-brain-tools", "telegram", "diagnostics-otel"],
    "load": {
      "paths": ["/app/extensions/second-brain-tools"]
    },
    "entries": {
      "second-brain-tools": {
        "enabled": true
      },
      "diagnostics-otel": {
        "enabled": true
      }
    }
  },
  "diagnostics": {
    "enabled": true,
    "otel": {
      "enabled": true,
      "endpoint": "http://tempo:4318",
      "protocol": "http/protobuf",
      "serviceName": "openclaw-agent",
      "traces": true,
      "metrics": true,
      "logs": true,
      "sampleRate": 1.0
    }
  },
  "tools": {
    "allow": ["second-brain-tools"],
    "exec": {
      "security": "deny"
    }
  }
}

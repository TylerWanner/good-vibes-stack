{
  "id": "second-brain-tools",
  "name": "Second Brain Tools",
  "description": "Expose second-brain HTTP API as OpenClaw agent tools.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "apiKey": {
        "type": "string"
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000
      }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "Second Brain API URL",
      "placeholder": "http://nervous-system-api:8001"
    },
    "apiKey": {
      "label": "Second Brain API Key"
    },
    "timeoutMs": {
      "label": "HTTP timeout (ms)"
    }
  }
}

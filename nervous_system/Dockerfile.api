# Stage 1: install dependencies
FROM python:3.12-slim AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
# Stub packages so pip can resolve deps without full source
RUN mkdir -p data integrations nervous_system orchestration second_brain shared \
    && touch data/__init__.py integrations/__init__.py nervous_system/__init__.py \
          orchestration/__init__.py second_brain/__init__.py shared/__init__.py

RUN pip install --no-cache-dir --prefix=/install .

# Stage 2: runtime
FROM python:3.12-slim

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application code
COPY . /app

# Install package metadata only (deps already installed)
RUN pip install --no-cache-dir --no-deps .

CMD ["uvicorn", "nervous_system.http.server:app", "--host", "0.0.0.0", "--port", "8001"]
